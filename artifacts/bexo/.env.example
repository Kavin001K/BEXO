# Mobile app (Expo) — copy to .env.local or set via EAS secrets.
# AI keys belong on api-server only (see BEXO/.env.example).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Production API (APK uses this). Local dev can omit to use LAN auto-detect.
EXPO_PUBLIC_API_BASE_URL=https://backend.mybexo.com

# Local api-server port when EXPO_PUBLIC_API_BASE_URL is unset (Replit uses 8080)
# EXPO_PUBLIC_API_DEV_PORT=8080

# Set to 1 to force production API from Expo Go (see docs/PRODUCTION-DEPLOY-CHECKLIST.md)
# EXPO_PUBLIC_FORCE_PROD=1

EXPO_PUBLIC_FRONTEND_URL=https://mybexo.com
